# OpenAI 兼容模型配置：DeepSeek Flash 本地示例；复制为 backend/.env 后填写真实密钥。
# API Key 只从未提交的本地 .env 读取，切勿把真实密钥写回此示例文件或提交到版本库。
OPENAI_API_KEY=
# DeepSeek 的 OpenAI 兼容接口地址；更换供应商时改成对应兼容 API 的 Base URL。
OPENAI_BASE_URL=https://api.deepseek.com
# 必须填写供应商支持的模型名，例如 deepseek-flash。
OPENAI_MODEL=deepseek-flash
# 思考模式开关，取值 enabled 或 disabled；留空表示不传该参数，由服务端默认行为决定。
# 本项目的工具调用由服务端合成，合成消息不带 reasoning_content；而思考型模型（如
# deepseek-flash）要求带 tools 的请求必须回传历史 reasoning_content，否则 400。
# 因此在线客服建议设为 disabled。它只影响在线 Agent；离线对话挖掘读 MINING_LLM_*。
OPENAI_THINKING_MODE=

# RAG 离线四策略/在线工作流评估的评审模型；网页按钮同时运行生成与评审。
# 网页允许相同 provider/model；以下三项全部留空时整组复用 OPENAI_*。
# 任一项已填写则按评审配置运行，须提供模型和密钥，不逐项混用客服配置。
# CLI 默认仍要求独立评审；同模型须显式传 --allow-shared-judge。
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=
# 显式配置评审服务时，地址留空使用 OpenAI 默认地址；其它兼容服务填写实际 Base URL。
EVAL_JUDGE_BASE_URL=

# Langfuse 可观测性：三项都配置后，在线 LangGraph 请求会上报完整调用树。
# 从 Langfuse 项目设置中获取公钥和私钥；地址填实际云区域或自部署地址。
# 真实密钥只放在未提交的 backend/.env；三项留空时关闭上报。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# MySQL 连接配置：账号、密码、地址和端口须与本地数据库实例一致。
# 该 URL 由服务和 Alembic 从环境读取；不要把真实数据库密码写入仓库。
DATABASE_URL=mysql+pymysql://aiden:change_me_app_password@127.0.0.1:3307/aiden?charset=utf8mb4

# 本地开发 Cookie 配置：HTTPS 部署时将 Secure 设为 true。
SESSION_COOKIE_NAME=aiden_session
SESSION_COOKIE_SECURE=false
# 登录 Cookie 有效期，单位为秒；默认值为七天。
SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# 离线建库与在线 search_faq（RAG）共用配置；两条路径都需要以下依赖和服务。
# 依赖安装：pip install -r requirements-rag.txt
# 以下均为占位值，真实地址与密钥请只写在未提交的 backend/.env 中。
# ---------------------------------------------------------------------------

# BGE-M3 dense 向量服务（OpenAI 兼容 /v1/embeddings 端点）。私有化部署时改成内网地址。
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# 服务未开启鉴权时留空；开启鉴权时填写真实密钥，切勿写入仓库。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度以实际模型输出为准；首次向量化时会与返回值校验，不一致会直接报错。
# BGE-M3 示例为 1024 维；512 维 bge-small 演示基线见 frontend/README.md，不复用不同模型集合。
EMBEDDING_DIMENSION=1024
# BGE-M3 支持的最长序列长度，切分预算从这里扣减。
# 换用其它 BGE 模型时必须改成该模型的上限（bge-small-zh-v1.5 为 512）。
EMBEDDING_MAX_SEQ_TOKENS=8192
# 精确长度计量：指向 BGE-M3 的本地 tokenizer.json；留空则退回按字符估算。
# 模型权重下载后 tokenizer.json 位于 HF 缓存目录，例如：
#   D:\hf-cache\hub\models--BAAI--bge-m3\snapshots\<hash>\tokenizer.json
EMBEDDING_TOKENIZER_PATH=
# 国内网络若无法直连 HuggingFace，把 HF_ENDPOINT 设为 https://hf-mirror.com 再下载模型。
# 该变量由 huggingface_hub 读取，不需要写在这里。
# 单次请求送多少条文本，只影响吞吐，不影响向量结果。
EMBEDDING_BATCH_SIZE=16

# 本地 Milvus 2.5+ BM25 实例；其它部署环境按实际端口配置。
MILVUS_URI=http://127.0.0.1:19531
# Milvus 未开启鉴权时留空。
MILVUS_TOKEN=
MILVUS_KNOWLEDGE_COLLECTION=knowledge_bm25
MILVUS_INSERT_BATCH_SIZE=64

# 在线知识检索（search_faq）：最终条数及 dense/BM25 每路候选数。
# 候选数至少等于结果数，用于补足 MySQL 校验后被过滤掉的失效命中。
RAG_ONLINE_RESULT_LIMIT=10
RAG_ONLINE_CANDIDATE_LIMIT=50
# 可选 dense、bm25、hybrid、hybrid_rerank；默认 hybrid_rerank。
RAG_ONLINE_STRATEGY=hybrid_rerank
# 可填已下载的本地模型目录，避免服务启动后首次检索时下载。
# 本机示例：D:\hf-cache\bge-reranker-v2-m3；其它机器按实际缓存路径配置。
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_LIMIT=10
# 重排分数的初筛阈值（sigmoid 后 0..1）；须用评估集校准。
RAG_MIN_RERANK_SCORE=0.35

# Markdown 知识文档目录；相对路径按 backend/ 解析。
RAG_KNOWLEDGE_DIR=knowledge
# 切分参数：单块上限、单句上限、相邻块重叠（token 数）。
# 单块上限同时受 EMBEDDING_MAX_SEQ_TOKENS 约束（取两者较小值），换成 bge-small 这类
# 512 长度上限的模型时必须同步调小 EMBEDDING_MAX_SEQ_TOKENS，否则块会超出模型可编码长度。
RAG_MAX_CHUNK_TOKENS=8192
RAG_MAX_SENTENCE_TOKENS=2048
RAG_OVERLAP_TOKENS=80
# 长度计量的不确定度与安全余量，会从单块预算中扣减。
RAG_MEASUREMENT_UNCERTAINTY_TOKENS=256
RAG_SAFETY_MARGIN_TOKENS=64
# 标题递归下钻的最大层数，以及表格每块保留的数据行数。
RAG_MAX_HEADING_DEPTH=6
RAG_TABLE_ROWS_PER_CHUNK=20
# 字符估算模式下 1 个 token 大约对应多少字符。
RAG_ESTIMATOR_CHARS_PER_TOKEN=1.1
# 设为 true 时，缺少精确分词器会直接报错，不再退回字符估算。
RAG_REQUIRE_EXACT_TOKENIZER=false

# ---------------------------------------------------------------------------
# 历史对话挖掘（RAG 知识抽取）配置：只有执行 scripts/mine_conversation_knowledge.py 时才需要。
# 该项能力复用上面的向量服务与 Milvus 配置；下面只列它自己的参数。以下均为占位值。
# ---------------------------------------------------------------------------

# 抽取模型。留空时回落到在线 Agent 使用的 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL。
# 单独指定可以让离线批量抽取与在线客服回答使用不同的模型或网关。
MINING_LLM_API_KEY=
MINING_LLM_BASE_URL=
MINING_LLM_MODEL=
# 单次请求超时（秒）与输出上限；抽取是照抄对话中已有的依据，温度默认取 0。
MINING_LLM_TIMEOUT=180
MINING_LLM_TEMPERATURE=0.0
MINING_LLM_MAX_TOKENS=2048
# 服务不支持 response_format=json_object 时设为 false。
MINING_LLM_USE_JSON_MODE=true
# 网络或响应解析失败时单个批次的最大尝试次数；结构校验失败不重试。
MINING_LLM_MAX_ATTEMPTS=2

# 批次切分：单批最多多少个完整问答轮次，单批对话文本最多多少字符。
# 两个上限任一先达到就切批，且切批只发生在轮次边界上，一轮问答不会被切到两个批次。
MINING_MAX_TURNS_PER_BATCH=8
MINING_MAX_BATCH_CHARS=6000
# 单次运行的规模上限：最多检查多少个会话、最多抽取多少个批次。
# 达到上限时本轮不做整体去重，剩余批次留给下一次运行（含定时轮次）。
MINING_MAX_CONVERSATIONS_PER_RUN=20
MINING_MAX_BATCHES_PER_RUN=40
# 单条候选问法与答案的长度上限（字符）；答案超限通常意味着模型把整段对话抄了回来。
MINING_MAX_QUESTION_CHARS=200
MINING_MAX_ANSWER_CHARS=800

# 本地定时启动需显式执行 .\start.ps1 -EnableConversationMining；默认启动不运行挖掘。
# 定时执行周期（秒）：定时模式每跑完一轮等待该时长；缺省 21600 表示六小时。
MINING_INTERVAL_SECONDS=21600
# 抽取并入库后是否顺势补齐 Milvus 向量；设为 false 则只写 MySQL，向量用建库命令另行补齐。
MINING_VECTORIZE_AFTER_PROMOTE=true

# 去重阈值（BGE-M3 余弦相似度）。归一化问法不同的候选用向量判断是否语义等价：
# 问法阈值较松（同义改写），答案阈值较严（答案差一点就是不同结论，不能并成一条）。
# 换用其它向量模型时必须重新标定这两个值。
MINING_QUESTION_SIMILARITY=0.88
MINING_ANSWER_SIMILARITY=0.95
# 一次去重最多为多少条不同问法计算向量。
MINING_MAX_SEMANTIC_QUESTIONS=500
# 向量服务不可用时是否中止入库；默认 false，退化为只合并归一化问法完全相同的候选。
MINING_REQUIRE_EMBEDDING_FOR_DEDUPE=false

# ---------------------------------------------------------------------------
# 员工主题分类器：管理员显式注册本地产物，员工主动选择后才加载/执行。
# 注册表 JSON 示例与权限/模式契约见 docs/主题分类器.md；相对路径按 backend/ 解析。
# 新增产物只编辑注册表，不扫描模型目录；注册合成实验不代表生产验收通过。
# 不再读取 TOPIC_CLASSIFIER_ARTIFACT_DIR / TOPIC_CLASSIFIER_DATASET。
# ---------------------------------------------------------------------------
TOPIC_CLASSIFIER_REGISTRY=app/config/topic_models.json
# 设备、任务锁/状态目录、报告目录只能由服务端配置，浏览器不能指定。
TOPIC_CLASSIFIER_DEVICE=cpu
TOPIC_CLASSIFIER_RUNTIME_DIR=.tmp/topic-console
TOPIC_CLASSIFIER_REPORT_DIR=.tmp/topic-console/reports
