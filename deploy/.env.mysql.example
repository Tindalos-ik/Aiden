# Copy to .env.mysql and replace both passwords before starting MySQL.
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=aiden
MYSQL_USER=aiden
MYSQL_PASSWORD=change_me_app_password
MYSQL_PORT=3307

# Keep this URL aligned with backend/.env. URL-encode reserved password characters.
DATABASE_URL=mysql+pymysql://aiden:change_me_app_password@127.0.0.1:3307/aiden?charset=utf8mb4
